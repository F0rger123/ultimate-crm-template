# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vite) — copy to .env for local dev. In Cloudflare Pages, set these
# as BUILD environment variables (they're baked into the JS bundle, so only
# put browser-safe values here).
# ─────────────────────────────────────────────────────────────────────────────

# Required. Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional — Web Push. Generate with `npm run gen:vapid` (public half only here).
VITE_VAPID_PUBLIC_KEY=

# Optional — Square Web Payments SDK environment: sandbox | production (default).
# Must match the server-side SQUARE_ENVIRONMENT below.
VITE_SQUARE_ENVIRONMENT=production

# Optional — email that can moderate the product feedback board / see the
# internal Cockpit page. Also add it to public.platform_admins (see schema.sql).
VITE_PLATFORM_ADMIN_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Server (Cloudflare Pages Functions) — NOT read by Vite. Set these in
# Cloudflare Pages → Settings → Variables and Secrets (mark secrets as
# "Secret"). For `wrangler pages dev` locally, put them in .dev.vars instead.
# Listed here for reference only.
# ─────────────────────────────────────────────────────────────────────────────

# Required
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=            # secret — full DB access, server only
# APP_ORIGIN=https://your-app.pages.dev

# Google OAuth token refresh (Gmail send / Calendar sync)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=                 # secret

# Web Push
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=                    # secret
# VAPID_SUBJECT=mailto:admin@example.com

# Scheduled endpoints (/api/check-reminders, /api/run-automations) — random strings
# CRON_SECRET=                          # secret
# REMINDERS_CRON_SECRET=                # secret
# AUTOMATIONS_CRON_SECRET=              # secret

# Stripe Connect (optional — lets each business connect its own Stripe account)
# STRIPE_CONNECT_CLIENT_ID=
# STRIPE_SECRET_KEY=                    # secret (platform account)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=                # secret
# STRIPE_CONNECT_STATE_SECRET=          # secret — random string

# Platform SaaS billing (optional — only if you sell this CRM as a subscription)
# PLATFORM_STRIPE_SECRET_KEY=           # secret
# PLATFORM_STRIPE_PUBLISHABLE_KEY=
# PLATFORM_STRIPE_WEBHOOK_SECRET=       # secret
# PLATFORM_RESEND_API_KEY=              # secret
# PLATFORM_RESEND_FROM=billing@example.com

# Square (optional — each business connects its own Square account in Settings)
# SQUARE_ENVIRONMENT=production         # sandbox | production

# Twilio fallback (optional — each business normally connects its own Twilio
# account in Settings; this is only used if none is connected)
# TWILIO_AUTH_TOKEN=                    # secret

# Social publishing (optional)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=                  # secret
